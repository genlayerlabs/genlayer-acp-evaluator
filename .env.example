PORT=3000

# GenLayer
GENLAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
GENLAYER_CHAIN=studionet

# ACP (Virtuals Agent Commerce Protocol)
# Get these from https://app.virtuals.io/acp/join after registering your agent
ACP_WALLET_PRIVATE_KEY=0xYOUR_WHITELISTED_WALLET_PRIVATE_KEY
ACP_ENTITY_ID=YOUR_ENTITY_ID
ACP_AGENT_WALLET_ADDRESS=0xYOUR_AGENT_WALLET_ADDRESS

# API authentication (required in production)
API_AUTH_TOKEN=

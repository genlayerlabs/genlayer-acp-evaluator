{
  "name": "genlayer-acp-evaluator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration/ --testTimeout 300000 --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@virtuals-protocol/acp-node": "^0.3.0-beta.39",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "genlayer-js": "latest",
    "viem": "^2.23.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}

{
  "name": "genlayer_eval",
  "displayName": "GenLayer Evaluation",
  "description": "Evaluates a provider deliverable against a rubric using an onchain GenLayer Intelligent Contract with validator-checked equivalence.",
  "price": 1,
  "currency": "USDC",
  "slaMinutes": 10,
  "visibility": "public",
  "requirementsSchema": {
    "type": "object",
    "properties": {
      "jobId": {
        "type": "string",
        "description": "Stable ACP-side job identifier"
      },
      "taskSpec": {
        "type": "string",
        "description": "Task specification or original request"
      },
      "submission": {
        "type": "string",
        "description": "Provider deliverable to evaluate"
      },
      "rubric": {
        "type": "string",
        "description": "Scoring or approval rubric"
      },
      "rubricVersion": {
        "type": "string",
        "description": "Optional rubric version label"
      },
      "scoreTolerance": {
        "type": "number",
        "description": "Optional GenLayer validator tolerance for score deltas"
      },
      "confidenceTolerance": {
        "type": "number",
        "description": "Optional GenLayer validator tolerance for confidence deltas"
      }
    },
    "required": ["jobId", "taskSpec", "submission", "rubric"]
  }
}
